<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:paddingHorizontal="24dp"
    tools:context=".ui.placeholder.ComingSoonFragment">

    <include
        android:id="@+id/topBar"
        layout="@layout/partial_top_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/featureIconCard"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:layout_marginTop="64dp"
        app:cardBackgroundColor="?attr/colorSecondaryContainer"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/coming_soon_icon"
            android:textColor="?attr/colorOnSecondaryContainer"
            android:textSize="36sp" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/featureTitleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:textColor="?attr/colorOnBackground"
        android:textSize="22sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/featureIconCard"
        tools:text="Multi-Day Ride" />

    <TextView
        android:id="@+id/comingSoonLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:letterSpacing="0.08"
        android:text="@string/coming_soon_label"
        android:textAllCaps="true"
        android:textColor="?attr/colorPrimary"
        android:textSize="13sp"
        app:layout_constraintBottom_toTopOf="@id/featureDescriptionText"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/featureTitleText" />

    <TextView
        android:id="@+id/featureDescriptionText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="15sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/comingSoonLabel"
        app:layout_constraintWidth_max="400dp"
        tools:text="Plan and track rides spanning multiple days, with per-day start/pause/end and a stitched trip summary." />

</androidx.constraintlayout.widget.ConstraintLayout>
