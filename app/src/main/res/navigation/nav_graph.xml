<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/onboardingFragment">

    <fragment
        android:id="@+id/onboardingFragment"
        android:name="com.ayushkataria.bikeryde.ui.onboarding.OnboardingFragment"
        android:label="Onboarding"
        tools:layout="@layout/fragment_onboarding">

        <action
            android:id="@+id/action_onboarding_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/onboardingFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.ayushkataria.bikeryde.ui.home.HomeFragment"
        android:label="BikeRyde"
        tools:layout="@layout/fragment_home">

        <action
            android:id="@+id/action_home_to_singleDayRide"
            app:destination="@id/singleDayRideFragment" />
        <action
            android:id="@+id/action_home_to_comingSoon"
            app:destination="@id/comingSoonFragment" />
        <action
            android:id="@+id/action_home_to_settings"
            app:destination="@id/settingsFragment" />
    </fragment>

    <fragment
        android:id="@+id/singleDayRideFragment"
        android:name="com.ayushkataria.bikeryde.ui.ride.SingleDayRideFragment"
        android:label="Single-Day Ride"
        tools:layout="@layout/fragment_single_day_ride">

        <action
            android:id="@+id/action_singleDayRide_to_renderEdit"
            app:destination="@id/renderEditFragment" />
    </fragment>

    <fragment
        android:id="@+id/renderEditFragment"
        android:name="com.ayushkataria.bikeryde.ui.render.RenderEditFragment"
        android:label="Customize"
        tools:layout="@layout/fragment_render_edit">

        <argument
            android:name="rideId"
            app:argType="long" />
        <argument
            android:name="renderType"
            app:argType="string" />

        <action
            android:id="@+id/action_renderEdit_to_renderPreview"
            app:destination="@id/renderPreviewFragment" />
    </fragment>

    <fragment
        android:id="@+id/renderPreviewFragment"
        android:name="com.ayushkataria.bikeryde.ui.render.RenderPreviewFragment"
        android:label="Preview"
        tools:layout="@layout/fragment_render_preview">

        <argument
            android:name="rideId"
            app:argType="long" />
        <argument
            android:name="renderType"
            app:argType="string" />
        <argument
            android:name="resultUri"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
    </fragment>

    <fragment
        android:id="@+id/comingSoonFragment"
        android:name="com.ayushkataria.bikeryde.ui.placeholder.ComingSoonFragment"
        android:label="Coming soon"
        tools:layout="@layout/fragment_coming_soon">

        <argument
            android:name="featureTitle"
            app:argType="string" />
        <argument
            android:name="featureDescription"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.ayushkataria.bikeryde.ui.settings.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings" />

</navigation>
